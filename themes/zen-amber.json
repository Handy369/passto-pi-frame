		"userMessageText": "#9a8a7a",
		"customMessageBg": "bgElevated",
		"customMessageText": "textMuted",
		"customMessageLabel": "accent",
		"toolPendingBg": "toolPending",
		"toolSuccessBg": "toolSuccess",
		"toolErrorBg": "toolError",
		"toolTitle": "textMuted",
		"toolOutput": "textDim",

		"mdHeading": "#c4a070",
