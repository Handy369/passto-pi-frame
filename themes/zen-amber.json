		"success": "#8a9a6a",
		"successMuted": "#4a5a3a",
		"error": "#b87a6a",
		"errorMuted": "#6a4a4a",
		"warning": "#c4a060",
		"warningMuted": "#6a5a3a",

		"borderSubtle": "#2a2825",
		"borderDefault": "#3a3630",
		"borderAccent": "#4a4440",

		"toolPending": "#1a1816",
		"toolSuccess": "#1a1e16",
		"toolError": "#1e1616"
